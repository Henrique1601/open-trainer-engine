{
  "name": "open-trainer-engine",
  "version": "0.2.0",
  "description": "Next-generation single-player game trainer engine, community mod hub, and in-game HUD overlay system.",
  "type": "module",
  "main": "dist/desktop/main.js",
  "types": "dist/index.d.ts",
  "bin": {
    "open-trainer": "dist/cli/index.js"
  },
  "keywords": [
    "game-trainer",
    "reverse-engineering",
    "aob-scanner",
    "memory-editing",
    "cheat-engine",
    "game-overlay",
    "steam-game-detector",
    "tauri",
    "electron"
  ],
  "author": "Henrique Bezerra Dos Santos",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Henrique1601/open-trainer-engine.git"
  },
  "scripts": {
    "build": "tsc && node -e \"const fs = require('fs'); fs.mkdirSync('dist/desktop/ui', {recursive:true}); fs.copyFileSync('src/desktop/ui/index.html', 'dist/desktop/ui/index.html'); fs.copyFileSync('src/desktop/ui/overlay.html', 'dist/desktop/ui/overlay.html'); fs.cpSync('assets', 'dist/assets', {recursive:true});\"",
    "app": "npm run build && electron dist/desktop/main.js",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win portable",
    "dist:installer": "npm run build && electron-builder --win nsis",
    "cli": "tsx src/cli/index.ts",
    "scan": "tsx src/cli/index.ts scan",
    "trainers": "tsx src/cli/index.ts trainers",
    "processes": "tsx src/cli/index.ts processes",
    "test": "vitest run",
    "validate:schema": "node -e \"console.log('Schema validation OK')\""
  },
  "build": {
    "appId": "com.opentrainer.engine",
    "productName": "Open Trainer Engine",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "configs/**/*",
      "assets/**/*",
      "build/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/koffi/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Open Trainer Engine",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  },
  "dependencies": {
    "fast-xml-parser": "^5.4.1",
    "koffi": "^3.3.4"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "electron": "^41.1.0",
    "electron-builder": "^26.18.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
